        <mxCell id="n9" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;shadow=1;spacing=6;fillColor=#eff6ff;strokeColor=#3b82f6;" value="&lt;font style=&#39;font-size:10px&#39; color=&#39;#64748b&#39;&gt;STEP 9&lt;/font&gt;&lt;br&gt;&lt;b&gt;ChunkParser (zod)&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:11px&#39; color=&#39;#475569&#39;&gt;line 1 = JSON {intent, confidence} · “---” · answer deltas&lt;/font&gt;" vertex="1">
