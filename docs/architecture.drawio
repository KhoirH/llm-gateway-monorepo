GraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;Data Flow — what lives where&lt;/b&gt;" style="text;html=1;fontSize=24;fontColor=#0f172a;fontFamily=Helvetica;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="18" width="1100" height="36" as="geometry"/></mxCell><mxCell id="sub" value="Offline build → Postgres stores → runtime gateway  ·  solid = data written / read  ·  dashed = reference" style="text;html=1;fontSize=12;fontColor=#64748b;fontFamily=Helvetica;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="56" width="1500" height="24" as="geometry"/></mxCell><mxCell id="bA" value="OFFLINE TOOLING · Python 3.12 + openai SDK in Docker (profile “tools”)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#fcd34d;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontStyle=1;fontSize=12;fontColor=#b45309;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="1500" height="310" as="geometry"/></mxCell><mxCell id="bB" value="STORES · PostgreSQL 16 + pgvector (infra-db-1 · localhost:5432)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#f5f3ff;strokeColor=#c4b5fd;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontStyle=1;fontSize=12;fontColor=#6d28d9;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="440" width="1500" height="200" as="geometry"/></mxCell><mxCell id="bC" value="RUNTIME · Gateway host process" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#86efac;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontStyle=1;fontSize=12;fontColor=#047857;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="700" width="1500" height="340" as="geometry"/></mxCell><mxCell id="d1" value="&lt;b&gt;HuggingFace&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#475569'&gt;Bitext customer-support dataset · 57k rows · 27 intents&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;shadow=1;spacing=6;fillColor=#f3f4f6;strokeColor=#6b7280;" vertex="1" parent="1"><mxGeometry x="70" y="150" width="190" height="100" as="geometry"/></mxCell><mxCell id="d2" value="&lt;b&gt;dataset.py&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#475569'&gt;dedupe by question · stratified split · 30 held-out first · 5 out-of-scope · ~600 KB slice&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;shadow=1;spacing=6;fillColor=#fff7ed;strokeColor=#f97316;" vertex="1" parent="1"><mxGeometry x="340" y="150" width="230" height="100" as="geometry"/></mxCell><mxCell id="d3" value="&lt;b&gt;data/ files&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#475569'&gt;kb.json (600 entries)&lt;br&gt;heldout.json (30 + 5)&lt;br&gt;committed for eval reproducibility&lt;/font&gt;" style="shape=cylinder3;boundedLbl=1;size=12;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;shadow=1;spacing=6;fillColor=#fefce8;strokeColor=#eab308;" vertex="1" parent="1"><mxGeometry x="650" y="140" width="210" height="120" as="geometry"/></mxCell><mxCell id="d4" value="&lt;b&gt;build_kb.py&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#475569'&gt;batches of 32 · backoff on 429/5xx · cache data/embeddings-cache.json&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;shadow=1;spacing=6;fillColor=#fff7ed;strokeColor=#f97316;" vertex="1" parent="1"><mxGeometry x="940" y="150" width="230" height="100" as="geometry"/></mxCell><mxCell id="dg" value="&lt;b&gt;Gemini embeddings API&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#475569'&gt;gemini-embedding-001 · 768-dim&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;shadow=1;spacing=6;fillColor=#f3f4f6;strokeColor=#6b7280;" vertex="1" parent="1"><mxGeometry x="1250" y="150" width="230" height="100" as="geometry"/></mxCell><mxCell id="ev" value="&lt;b&gt;Eval runner&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#475569'&gt;heldout.json · Config A vs B · via gateway-a / gateway-b&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;shadow=1;spacing=6;fillColor=#fff7ed;strokeColor=#f97316;" vertex="1" parent="1"><mxGeometry x="650" y="300" width="210" height="90" as="geometry"/></mxCell><mxCell id="eo" value="&lt;b&gt;docs/eval-results/&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#475569'&gt;*.json + *.md · intent accuracy, cosine quality, refusal precision&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;shadow=1;spacing=6;fillColor=#fefce8;strokeColor=#eab308;" vertex="1" parent="1"><mxGeometry x="340" y="300" width="230" height="90" as="geometry"/></mxCell><mxCell id="s1" value="&lt;b&gt;tenants + api_keys&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#475569'&gt;SHA-256 key hash + prefix&lt;br&gt;daily_token_quota · tokens_used&lt;/font&gt;" style="shape=cylinder3;boundedLbl=1;size=12;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;shadow=1;spacing=6;fillColor=#eff6ff;strokeColor=#3b82f6;" vertex="1" parent="1"><mxGeometry x="70" y="490" width="200" height="120" as="geometry"/></mxCell><mxCell id="s2" value="&lt;b&gt;requests&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#475569'&gt;tenant · capability · model_used · usage · ttft_ms · outcome · fallback_fired · route_steps JSONB&lt;/font&gt;" style="shape=cylinder3;boundedLbl=1;size=12;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;shadow=1;spacing=6;fillColor=#eff6ff;strokeColor=#3b82f6;" vertex="1" parent="1"><mxGeometry x="310" y="490" width="220" height="120" as="geometry"/></mxCell><mxCell id="s3" value="&lt;b&gt;routing_attempts&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#475569'&gt;attempt n · backend · reason · outcome · latency_ms · error&lt;/font&gt;" style="shape=cylinder3;boundedLbl=1;size=12;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;shadow=1;spacing=6;fillColor=#eff6ff;strokeColor=#3b82f6;" vertex="1" parent="1"><mxGeometry x="570" y="490" width="200" height="120" as="geometry"/></mxCell><mxCell id="s4" value="&lt;b&gt;kb_entries&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#475569'&gt;question · answer · intent&lt;br&gt;vector(768) · HNSW cosine&lt;/font&gt;" style="shape=cylinder3;boundedLbl=1;size=12;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;shadow=1;spacing=6;fillColor=#f5f3ff;strokeColor=#8b5cf6;" vertex="1" parent="1"><mxGeometry x="945" y="490" width="220" height="120" as="geometry"/></mxCell><mxCell id="sql" value="&lt;b&gt;Quota reserve (atomic · fail closed)&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:10px&quot;&gt;UPDATE tenants SET tokens_used = tokens_used + $2 WHERE id = $1 AND tokens_used + $2 &amp;lt;= daily_token_quota&lt;/font&gt;&lt;br&gt;0 rows → 429 · DB error → 503" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c4b5fd;strokeWidth=1.5;align=left;verticalAlign=top;spacing=12;fontSize=11;fontColor=#334155;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1210" y="490" width="300" height="120" as="geometry"/></mxCell><mxCell id="gw" value=