                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "setTimeout(() => pm.execution.abortRequest?.(), 300);"
                ]
              }
            }
          ]
