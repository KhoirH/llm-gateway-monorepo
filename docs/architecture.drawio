        <mxCell id="ep" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1.5;align=left;verticalAlign=top;spacing=12;fontSize=11;fontColor=#334155;fontFamily=Helvetica;" value="&lt;b&gt;ENDPOINTS&lt;/b&gt;&lt;br&gt;POST /v1/chat/completions — OpenAI-style, &lt;i&gt;stream&lt;/i&gt; optional (default false)&lt;br&gt;POST /v1/capabilities/support/answer — SSE: meta · retrieval · delta · final · error&lt;br&gt;GET /v1/usage — caller’s own tenant only&lt;br&gt;GET /v1/requests/:id — trace + route steps (tenant-scoped)&lt;br&gt;GET /healthz — liveness&lt;br&gt;Headers: x-request-id · x-model-used · x-fallback-fired" vertex="1">
          <mxGeometry height="170" width="560" x="640" y="90" as="geometry" />
        </mxCell>
        <mxCell id="leg" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1.5;align=left;verticalAlign=top;spacing=12;fontSize=11;fontColor=#334155;fontFamily=Helvetica;" value="&lt;b&gt;LEGEND&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#10b981&quot;&gt;■&lt;/font&gt; client / delivery &amp;nbsp; &lt;font color=&quot;#3b82f6&quot;&gt;■&lt;/font&gt; processing / metering &amp;nbsp; &lt;font color=&quot;#f97316&quot;&gt;■&lt;/font&gt; routing &amp;amp; model&lt;br&gt;&lt;font color=&quot;#ef4444&quot;&gt;■&lt;/font&gt; failure / guard path &amp;nbsp; &lt;font color=&quot;#8b5cf6&quot;&gt;■&lt;/font&gt; storage&lt;br&gt;Solid arrow = main flow · dashed = retry, reference or policy" vertex="1">
          <mxGeometry height="110" width="550" x="1290" y="90" as="geometry" />
        </mxCell>
        <mxCell id="seed" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1.5;align=left;verticalAlign=top;spacing=12;fontSize=11;fontColor=#334155;fontFamily=Helvetica;" value="&lt;b&gt;SEED TENANTS&lt;/b&gt;&lt;br&gt;acme — all models, normal quota&lt;br&gt;globex — tiny quota, &lt;i&gt;fast&lt;/i&gt; only (quota tests)&lt;br&gt;chaos — mock primary with configurable failure rate (fallback demo)" vertex="1">
          <mxGeometry height="100" width="550" x="1290" y="230" as="geometry" />
        </mxCell>
        <mxCell id="rules" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1.5;align=left;verticalAlign=top;spacing=12;fontSize=11;fontColor=#334155;fontFamily=Helvetica;" value="&lt;b&gt;ROUTING HARD RULES&lt;/b&gt;&lt;br&gt;• Fallback only before the first token reaches the client&lt;br&gt;• Mid-stream break → &lt;i&gt;error&lt;/i&gt; event with partial text, outcome partial_failure&lt;br&gt;• Provider 4xx other than 429 fails fast (no fallback)&lt;br&gt;• writeHead delayed until first token so x-model-used is correct&lt;br&gt;• Every attempt writes a routing_attempts row" vertex="1">
          <mxGeometry height="160" width="560" x="40" y="850" as="geometry" />
        </mxCell>
