{
  "info": {
    "_postman_id": "b7e1c2d3-4a5f-4c6d-8e9f-0a1b2c3d4e5f",
    "name": "LLM Gateway",
    "description": "Postman collection for the LLM Gateway (Approach B). Start the stack: `npm run db:up`, `npm run db:migrate`, `npm run db:seed`, `npm run kb:build`, then `npm run gateway:dev`.\n\nNotes:\n- Demo API keys change on every `npm run db:seed`; update variables acmeKey/globexKey/chaosKey after re-seeding.\n- Chat endpoint: body `stream` optional (default false = JSON completion; true = SSE).\n- Support assistant streams SSE events: meta, retrieval, delta, final, error (low confidence -> final with refused=true).\n- GET /v1/requests/:id returns the trace (metering + routing attempts + route steps); set requestId from a previous response's x-request-id header.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:3000"
    },
    {
      "key": "acmeKey",
      "value": "PASTE_KEY_FROM_NPM_RUN_DB_SEED"
    },
    {
      "key": "globexKey",
      "value": "PASTE_KEY_FROM_NPM_RUN_DB_SEED"
    },
    {
      "key": "chaosKey",
      "value": "PASTE_KEY_FROM_NPM_RUN_DB_SEED"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "GET /healthz",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/healthz"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('status ok', () => pm.expect(pm.response.json().status).to.eql('ok'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Chat Completions (SSE)",
      "item": [
        {
          "name": "Chat - mock backend (acme)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{acmeKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/v1/chat/completions",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"model\": \"mock\",\n  \"messages\": [\n    { \"role\": \"user\", \"content\": \"halo gateway\" }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('SSE content type', () => pm.expect(pm.response.headers.get('content-type')).to.include('text/event-stream'));",
                  "pm.test('x-model-used mock', () => pm.expect(pm.response.headers.get('x-model-used')).to.eql('mock'));",
                  "pm.test('x-fallback-fired false', () => pm.expect(pm.response.headers.get('x-fallback-fired')).to.eql('false'));",
                  "pm.test('x-request-id present', () => pm.expect(pm.response.headers.get('x-request-id')).to.not.be.undefined);",
                  "pm.test('ends with [DONE]', () => pm.expect(pm.response.text()).to.include('data: [DONE]'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Chat - non-streaming JSON (default, no stream field)",
          "request": {
            "method": "POST",
            "header": [
