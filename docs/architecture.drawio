<mxfile host="app.diagrams.net" modified="2026-11-01T00:00:00.000Z" agent="LLM Gateway docs" version="21.0.0" type="device"><diagram id="ai-flow" name="1 - AI Flow"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1150" math="0" shadow="0" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;AI Flow — support request pipeline&lt;/b&gt;" style="text;html=1;fontSize=24;fontColor=#0f172a;fontFamily=Helvetica;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="18" width="1100" height="36" as="geometry"/></mxCell><mxCell id="sub" value="POST /v1/capabilities/support/answer  ·  numbered = order of execution  ·  suffix “b” = branch / recovery path" style="text;html=1;fontSize=12;fontColor=#64748b;fontFamily=Helvetica;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="56" width="1500" height="24" as="geometry"/></mxCell><mxCell id="z1" value="EDGE &amp;amp; GUARDRAILS" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#f7fef9;strokeColor=#86efac;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontStyle=1;fontSize=12;fontColor=#047857;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="250" height="490" as="geometry"/></mxCell><mxCell id="z2" value="RETRIEVAL (RAG)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#f5f9ff;strokeColor=#93c5fd;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontStyle=1;fontSize=12;fontColor=#1d4ed8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="340" y="420" width="250" height="270" as="geometry"/></mxCell><mxCell id="z3" value="ROUTING &amp;amp; GENERATION" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#fffaf5;strokeColor=#fdba74;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontStyle=1;fontSize=12;fontColor=#c2410c;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="640" y="525" width="610" height="545" as="geometry"/></mxCell><mxCell id="z4" value="QUALITY GATE" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#fffdf5;strokeColor=#fcd34d;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontStyle=1;fontSize=12;fontColor=#b45309;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1290" y="760" width="250" height="330" as="geometry"/></mxCell><mxCell id="z5" value="DELIVERY &amp;amp; METERING" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#f7fef9;strokeColor=#86efac;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontStyle=1;fontSize=12;fontColor=#047857;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1590" y="760" width="250" height="330" as="geometry"/></mxCell><mxCell id="n1" value="&lt;font style='font-size:10px' color='#64748b'&gt;STEP 1&lt;/font&gt;&lt;br&gt;&lt;b&gt;Console Playground&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#475569'&gt;browser · POST /v1/capabilities/support/answer&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;shadow=1;spacing=6;fillColor=#ecfdf5;strokeColor=#10b981;" vertex="1" parent="1"><mxGeometry x="60" y="140" width="210" height="80" as="geometry"/></mxCell><mxCell id="n2" value="&lt;font style='font-size:10px' color='#64748b'&gt;STEP 2&lt;/font&gt;&lt;br&gt;&lt;b&gt;Vite dev proxy&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#475569'&gt;/v1 → gateway :3000 (no CORS in dev)&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;shadow=1;spacing=6;fillColor=#ecfdf5;strokeColor=#10b981;" vertex="1" parent="1"><mxGeometry x="60" y="250" width="210" height="80" as="geometry"/></mxCell><mxCell id="n3" value="&lt;font style='font-size:10px' color='#64748b'&gt;STEP 3&lt;/font&gt;&lt;br&gt;&lt;b&gt;Auth&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#475569'&gt;Bearer key → SHA-256 lookup in api_keys&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;shadow=1;spacing=6;fillColor=#eff6ff;strokeColor=#3b82f6;" vertex="1" parent="1"><mxGeometry x="60" y="360" width="210" height="80" as="geometry"/></mxCell><mxCell id="n4" value="&lt;font style='font-size:10px' color='#64748b'&gt;STEP 4&lt;/font&gt;&lt;br&gt;&lt;b&gt;Quota reserve (atomic)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#475569'&gt;estimate = chars/4 + 600 + 512 · fail closed&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;shadow=1;spacing=6;fillColor=#eff6ff;strokeColor=#3b82f6;" vertex="1" parent="1"><mxGeometry x="60" y="470" width="210" height="80" as="geometry"/></mxCell><mxCell id="err" value="&lt;font style='font-size:10px' color='#64748b'&gt;EARLY EXIT&lt;/font&gt;&lt;br&gt;&lt;b&gt;Before any backend call&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#475569'&gt;401 invalid_api_key&lt;br&gt;429 quota_exhausted&lt;br&gt;503 quota_unavailable&lt;br&gt;{error:{code,message,request_id}}&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;shadow=1;spacing=6;fillColor=#fef2f2;strokeColor=#ef4444;" vertex="1" parent="1"><mxGeometry x="60" y="630" width="210" height="130" as="geometry"/></mxCell><mxCell id="n5" value="&lt;font style='font-size:10px' color='#64748b'&gt;STEP 5&lt;/font&gt;&lt;br&gt;&lt;b&gt;Embed query&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#475569'&gt;Gemini embeddings · 768-dim&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;shadow=1;spacing=6;fillColor=#eff6ff;strokeColor=#3b82f6;" vertex="1" parent="1"><mxGeometry x="360" y="470" width="210" height="80" as="geometry"/></mxCell><mxCell id="n6" value="&lt;font style='font-size:10px' color='#64748b'&gt;STEP 6&lt;/font&gt;&lt;br&gt;&lt;b&gt;Retrieve top-4&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#475569'&gt;pgvector cosine · HNSW index&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;shadow=1;spacing=6;fillColor=#eff6ff;strokeColor=#3b82f6;" vertex="1" parent="1"><mxGeometry x="360" y="580" width="210" height="80" as="geometry"/></mxCell><mxCell id="kb" value="&lt;b&gt;kb_entries&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#475569'&gt;~600 entries · vector(768)&lt;/font&gt;" style="shape=cylinder3;boundedLbl=1;size=12;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;shadow=1;spacing=6;fillColor=#f5f3ff;strokeColor=#8b5cf6;" vertex="1" parent="1"><mxGeometry x="365" y="730" width="200" height="90" as="geometry"/></mxCell><mxCell id="n7" value="&lt;font style='font-size:10px' color='#64748b'&gt;STEP 7&lt;/font&gt;&lt;br&gt;&lt;b&gt;route() — tier selection&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#475569'&gt;top-1 ≥ 0.80 and input &amp;lt; 120 tok → fast, else strong&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;shadow=1;spacing=6;fillColor=#fff7ed;strokeColor=#f97316;" vertex="1" parent="1"><mxGeometry x="680" y="575" width="210" height="90" as="geometry"/></mxCell><mxCell id="pol" value="&lt;b&gt;Tenant policy (hard filter)&lt;/b&gt;&lt;br&gt;allowed_models only; empty → 403 model_not_allowed. chaos tenant: mock first. SUPPORT_MODEL_OVERRIDE pins tier for eval." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#fcd34d;strokeWidth=1.5;align=left;verticalAlign=top;spacing=12;fontSize=11;fontColor=#334155;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="680" y="395" width="210" height="115" as="geometry"/></mxCell><mxCell id="cap" value="&lt;font style='font-size:10px' color='#64748b'&gt;STEP 8c&lt;/font&gt;&lt;br&gt;&lt;b&gt;Retry cap — src/retry.ts&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#475569'&gt;MAX_CONSECUTIVE_RETRIES = 3&lt;br&gt;1. attempt 1 · fast (primary)&lt;br&gt;2. attempt 2 · strong (fallback)&lt;br&gt;3. attempt 3 · fast (cycle)&lt;br&gt;then close chat · mapped error&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;shadow=1;spacing=6;fillColor=#fef2f2;strokeColor=#ef4444;" vertex="1" parent="1"><mxGeometry x="1000" y="555" width="210" height="120" as="geometry"/></mxCell><mxCell id="n8" value="&lt;font style='font-size:10px' color='#64748b'&gt;STEP 8&lt;/font&gt;&lt;br&gt;&lt;b&gt;Attempt loop&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#475569'&gt;TTFT timeout 3 s · total 20 s · client abort cancels upstream&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;shadow=1;spacing=6;fillColor=#fff7ed;strokeColor=#f97316;" vertex="1" parent="1"><mxGeometry x="680" y="700" width="210" height="90" as="geometry"/></mxCell><mxCell id="fb" value="&lt;font style='font-size:10px' color='#64748b'&gt;STEP 8b&lt;/font&gt;&lt;br&gt;&lt;b&gt;Fallback / retry&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#475569'&gt;next backend on 4xx / 5xx / 429 / conn / timeout · only before first token&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;shadow=1;spacing=6;fillColor=#fef2f2;strokeColor=#ef4444;" vertex="1" parent="1"><mxGeometry x="1000" y="700" width="210" height="90" as="geometry"/></mxCell><mxCell id="n9" value="&lt;font style='font-size:10px' color='#64748b'&gt;STEP 9&lt;/font&gt;&lt;br&gt;&lt;b&gt;ChunkParser (zod)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#475569'&gt;line 1 = JSON {intent, confidence} · “---” · answer deltas&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;shadow=1;spacing=6;fillColor=#eff6ff;strokeColor=#3b82f6;" vertex="1" parent="1"><mxGeometry x="680" y="820" width="210" height="90" as="geometry"/></mxCell><mxCell id="rp" value="&lt;font style='font-size:10px' color='#64748b'&gt;STEP 9b&lt;/font&gt;&lt;br&gt;&lt;b&gt;Repair retry&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#475569'&gt;1 retry, own attempt, same backend · then 502 bad_output&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;shadow=1;spacing=6;fillColor=#fef2f2;strokeColor=#ef4444;" vertex="1" parent="1"><mxGeometry x="680" y="950" width="210" height="80" as="geometry"/></mxCell><mxCell id="n10" value="&lt;font style='font-size:10px' color='#64748b'&gt;STEP 10&lt;/font&gt;&lt;br&gt;&lt;b&gt;Confidence score&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#475569'&gt;0.4×top-1 + 0.3×intent agreement + 0.3×self-reported · threshold 0.55&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;shadow=1;spacing=6;fillColor=#fff7ed;strokeColor=#f97316;" vertex="1" parent="1"><mxGeometry x="1310" y="810" width="210" height="110" as="geometry"/></mxCell><mxCell id="rf" value="&lt;font style='font-size:10px' color='#64748b'&gt;STEP 10b&lt;/font&gt;&lt;br&gt;&lt;b&gt;Refused&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#475569'&gt;abort upstream · fixed clarification reply · refused: true · no answer billed&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;shadow=1;spacing=6;fillColor=#fef2f2;strokeColor=#ef4444;" vertex="1" parent="1"><mxGeometry x="1310" y="950" width="210" height="110" as="geometry"/></mxCell><mxCell id="n11" value="&lt;font style='font-size:10px' color='#64748b'&gt;STEP 11&lt;/font&gt;&lt;br&gt;&lt;b&gt;SSE stream to client&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#475569'&gt;meta → retrieval → delta* → final&lt;br&gt;headers flushed at first token&lt;br&gt;mid-stream break → partial_failure&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;shadow=1;spacing=6;fillColor=#ecfdf5;strokeColor=#10b981;" vertex="1" parent="1"><mxGeometry x="1610" y="800" width="210" height="130" as="geometry"/></mxCell><mxCell id="n12" value="&lt;font style='font-size:10px' color='#64748b'&gt;STEP 12&lt;/font&gt;&lt;br&gt;&lt;b&gt;Metering (finally)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#475569'&gt;reconcile quota with actual usage · refund if no call succeeded · requests + routing_attempts&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;shadow=1;spacing=6;fillColor=#eff6ff;strokeColor=#3b82f6;" vertex="1" parent="1"><mxGeometry x="1610" y="950" width="210" height="110" as="geometry"/></mxCell><mxCell id="ep" value="&lt;b&gt;ENDPOINTS&lt;/b&gt;&lt;br&gt;POST /v1/chat/completions — OpenAI-style, &lt;i&gt;stream&lt;/i&gt; optional (default false)&lt;br&gt;POST /v1/capabilities/support/answer — SSE: meta · retrieval · delta · final · error&lt;br&gt;GET /v1/usage — caller’s own tenant only&lt;br&gt;GET /v1/requests/:id — trace + route steps (tenant-scoped)&lt;br&gt;GET /healthz — liveness&lt;br&gt;Headers: x-request-id · x-model-used · x-fallback-fired" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1.5;align=left;verticalAlign=top;spacing=12;fontSize=11;fontColor=#334155;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="640" y="90" width="560" height="140" as="geometry"/></mxCell><mxCell id="leg" value="&lt;b&gt;LEGEND&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#10b981&quot;&gt;■&lt;/font&gt; client / delivery &amp;nbsp; &lt;font color=&quot;#3b82f6&quot;&gt;■&lt;/font&gt; processing / metering &amp;nbsp; &lt;font color=&quot;#f97316&quot;&gt;■&lt;/font&gt; routing &amp;amp; model&lt;br&gt;&lt;font color=&quot;#ef4444&quot;&gt;■&lt;/font&gt; failure / guard path &amp;nbsp; &lt;font color=&quot;#8b5cf6&quot;&gt;■&lt;/font&gt; storage&lt;br&gt;Solid arrow = main flow · dashed = retry, reference or policy" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1.5;align=left;verticalAlign=top;spacing=12;fontSize=11;fontColor=#334155;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1290" y="90" width="550" height="95" as="geometry"/></mxCell><mxCell id="seed" value="&lt;b&gt;SEED TENANTS&lt;/b&gt;&lt;br&gt;acme — all models, normal quota&lt;br&gt;globex — tiny quota, &lt;i&gt;fast&lt;/i&gt; only (quota tests)&lt;br&gt;chaos — mock primary with configurable failure rate (fallback demo)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1.5;align=left;verticalAlign=top;spacing=12;fontSize=11;fontColor=#334155;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1290" y="205" width="550" height="85" as="geometry"/></mxCell><mxCell id="rules" value="&lt;b&gt;ROUTING HARD RULES&lt;/b&gt;&lt;br&gt;• Fallback only before the first token reaches the client&lt;br&gt;• Mid-stream break → &lt;i&gt;error&lt;/i&gt; event with partial text, outcome partial_failure&lt;br&gt;• All backend errors retried: 4xx (incl. 429), 5xx, conn, timeout&lt;br&gt;• Cap: 3 consecutive failed attempts cycling the chain (fast → strong → fast), then the chat closes with the mapped error (policy only in src/retry.ts)&lt;br&gt;• writeHead delayed until first token so x-model-used is correct&lt;br&gt;• Every attempt writes a routing_attempts row" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1.5;align=left;verticalAlign=top;spacing=12;fontSize=11;fontColor=#334155;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="850" width="560" height="165" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;strokeColor=#64748b;fontColor=#334155;" edge="1" parent="1" source="n1" target="n2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;strokeColor=#64748b;fontColor=#334155;" edge="1" parent="1" source="n2" target="n3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;strokeColor=#64748b;fontColor=#334155;" edge="1" parent="1" source="n3" target="n4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="reserved" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;strokeColor=#64748b;fontColor=#334155;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n4" target="n5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="768-dim" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;strokeColor=#64748b;fontColor=#334155;" edge="1" parent="1" source="n5" target="n6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="top-1 sim" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;strokeColor=#64748b;fontColor=#334155;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n6" target="n7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;strokeColor=#64748b;fontColor=#334155;" edge="1" parent="1" source="n7" target="n8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="stream" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;strokeColor=#64748b;fontColor=#334155;" edge="1" parent="1" source="n8" target="n9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value="pre-token error" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;strokeColor=#ef4444;fontColor=#b91c1c;exitX=1;exitY=0.3;entryX=0;entryY=0.3;" edge="1" parent="1" source="n8" target="fb"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" value="next backend" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;strokeColor=#ef4444;fontColor=#b91c1c;dashed=1;exitX=0;exitY=0.7;entryX=1;entryY=0.7;" edge="1" parent="1" sourc