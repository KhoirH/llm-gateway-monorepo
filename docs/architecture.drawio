        <mxCell id="t1" value="AI Flow — support request pipeline (numbered = order of execution)" style="text;html=1;fontSize=16;fontStyle=1" vertex="1" parent="1"><mxGeometry x="80" y="20" width="700" height="30" as="geometry" /></mxCell>
        <mxCell id="n1" value="1&#10;Console Playground (browser)&#10;POST /v1/capabilities/support/answer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="80" y="70" width="220" height="60" as="geometry" /></mxCell>
        <mxCell id="n2" value="2&#10;Vite dev proxy /v1 &#8594; gateway :3000" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="80" y="160" width="220" height="50" as="geometry" /></mxCell>
        <mxCell id="n3" value="3&#10;Auth: Bearer key &#8594; SHA-256 lookup (api_keys)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="80" y="240" width="220" height="50" as="geometry" /></mxCell>
        <mxCell id="n4" value="4&#10;Quota reserve (estimate: chars/4 + 600 + 512)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="80" y="320" width="220" height="50" as="geometry" /></mxCell>
        <mxCell id="n5" value="5&#10;Embed query (Gemini embeddings, 768-dim)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="80" y="400" width="220" height="50" as="geometry" /></mxCell>
        <mxCell id="n6" value="6&#10;Retrieve top-4 (pgvector cosine, HNSW)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="80" y="480" width="220" height="50" as="geometry" /></mxCell>
        <mxCell id="n7" value="7&#10;route(): tier selection&#10;top1 &#8805; 0.80 &amp; input &lt; 120 tok &#8594; fast, else strong&#10;(SUPPORT_MODEL_OVERRIDE pins tier for eval)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="80" y="560" width="220" height="80" as="geometry" /></mxCell>
        <mxCell id="n8" value="8&#10;Attempt loop: call backend (GLM via z.ai)&#10;TTFT timeout 3s &#183; total 20s &#183; client abort" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="80" y="670" width="220" height="70" as="geometry" /></mxCell>
        <mxCell id="n9" value="9&#10;ChunkParser: line 1 = JSON {intent, confidence}&#10;&#39;---&#39; separator &#8594; answer deltas (reasoning ignored)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="80" y="770" width="220" height="70" as="geometry" /></mxCell>
        <mxCell id="n10" value="10&#10;Confidence = 0.4&#215;top1 + 0.3&#215;intent agreement + 0.3&#215;self-reported" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="420" y="770" width="240" height="70" as="geometry" /></mxCell>
        <mxCell id="n11" value="12&#10;Fallback: next backend in chain on 5xx / 429 / conn / timeout&#10;only before first token reaches the client" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="420" y="670" width="240" height="70" as="geometry" /></mxCell>
        <mxCell id="n12" value="11a&#10;Refused: confidence &lt; 0.55&#10;abort upstream &#183; no answer billed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="700" y="770" width="200" height="70" as="geometry" /></mxCell>
        <mxCell id="n13" value="11b&#10;Bad header &#8594; 1 repair retry&#10;(own attempt, same backend)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="700" y="670" width="200" height="70" as="geometry" /></mxCell>
        <mxCell id="n14" value="13&#10;SSE stream to client: meta &#8594; retrieval &#8594; delta* &#8594; final&#10;(meta + retrieval flushed at first model token so x-model-used is correct)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="420" y="560" width="240" height="80" as="geometry" /></mxCell>
