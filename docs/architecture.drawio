        </mxCell>
        <mxCell id="n11" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;shadow=1;spacing=6;fillColor=#ecfdf5;strokeColor=#10b981;" value="&lt;font style=&#39;font-size:10px&#39; color=&#39;#64748b&#39;&gt;STEP 11&lt;/font&gt;&lt;br&gt;&lt;b&gt;SSE stream to client&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:11px&#39; color=&#39;#475569&#39;&gt;meta → retrieval → delta* → final&lt;br&gt;headers flushed at first token&lt;br&gt;mid-stream break → partial_failure&lt;/font&gt;" vertex="1">
          <mxGeometry height="130" width="210" x="1610" y="800" as="geometry" />
        </mxCell>
        <mxCell id="n12" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;shadow=1;spacing=6;fillColor=#eff6ff;strokeColor=#3b82f6;" value="&lt;font style=&#39;font-size:10px&#39; color=&#39;#64748b&#39;&gt;STEP 12&lt;/font&gt;&lt;br&gt;&lt;b&gt;Metering (finally)&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:11px&#39; color=&#39;#475569&#39;&gt;reconcile quota with actual usage · refund if no call succeeded · requests + routing_attempts&lt;/font&gt;" vertex="1">
