        <mxCell id="rp" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;shadow=1;spacing=6;fillColor=#fef2f2;strokeColor=#ef4444;" value="&lt;font style=&#39;font-size:10px&#39; color=&#39;#64748b&#39;&gt;STEP 9b&lt;/font&gt;&lt;br&gt;&lt;b&gt;Repair retry&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:11px&#39; color=&#39;#475569&#39;&gt;1 retry, own attempt, same backend · then 502 bad_output&lt;/font&gt;" vertex="1">
          <mxGeometry height="80" width="210" x="680" y="950" as="geometry" />
        </mxCell>
        <mxCell id="n10" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;shadow=1;spacing=6;fillColor=#fff7ed;strokeColor=#f97316;" value="&lt;font style=&#39;font-size:10px&#39; color=&#39;#64748b&#39;&gt;STEP 10&lt;/font&gt;&lt;br&gt;&lt;b&gt;Confidence score&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:11px&#39; color=&#39;#475569&#39;&gt;0.4×top-1 + 0.3×intent agreement + 0.3×self-reported · threshold 0.55&lt;/font&gt;" vertex="1">
